# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fixed business timezone (IANA name) used for all calendar math
APPOINTMENT_TIMEZONE=America/Sao_Paulo
# Long random secret used only to HMAC network identifiers for booking rate limits
BOOKING_RATE_LIMIT_SECRET=

# Email notifications (Resend → API Keys / Domains)
RESEND_API_KEY=
# A verified sender, e.g. Owntime <agenda@yourdomain.com>
RESEND_FROM_EMAIL=
# One or more admin recipients, comma-separated
ADMIN_NOTIFICATION_EMAILS=

# Google Calendar API (OAuth web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One or more exact callback URLs registered under "Authorized redirect URIs" in
# Google Cloud. For multiple environments, use GOOGLE_OAUTH_REDIRECT_URIS with a
# comma-separated list (localhost, tunnel and production).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:3000/api/integrations/google/callback,https://your-domain.com/api/integrations/google/callback
# Long random secret used to encrypt refresh tokens at rest
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Public HTTPS endpoint used by Google push notifications (production only)
GOOGLE_CALENDAR_WEBHOOK_URL=
# Random values used to authenticate webhook and scheduled sync requests
GOOGLE_WEBHOOK_SECRET=
CRON_SECRET=

# Server-only Supabase key, required by the public booking endpoint and Google sync.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
